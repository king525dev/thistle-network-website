{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "startDate": {
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime"
    },
    "registrationUrl": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "eventStatus": {
      "type": "enumeration",
      "enum": [
        "upcoming",
        "next",
        "previous",
        "past"
      ]
    },
    "gallery_album": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::gallery-album.gallery-album",
      "inversedBy": "event"
    }
  }
}
